rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /classes/{classCode} {
      allow read, write: if true;

      match /students/{studentId} {
        allow read, write: if true;
      }

      match /transactions/{txId} {
        allow read, write: if true;
      }
    }
  }
}

